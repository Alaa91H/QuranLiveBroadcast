[Unit]
Description=Quran 24/7 YouTube Stream - Afasy High Quality
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/quran-24-7
EnvironmentFile=-%h/quran-24-7/.env
ExecStart=%h/quran-24-7/scripts/stream_youtube.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:%h/quran-24-7/logs/systemd_youtube.log
StandardError=append:%h/quran-24-7/logs/systemd_youtube.log

[Install]
WantedBy=default.target