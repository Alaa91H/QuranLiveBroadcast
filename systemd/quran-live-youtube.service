[Unit]
Description=Quran 24/7 YouTube Stream - Afasy High Quality
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/quran-live-stream
EnvironmentFile=-%h/quran-live-stream/.env
ExecStart=%h/quran-live-stream/scripts/stream_youtube.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
# Scheduler priority for the realtime encode + OOM order: the stream is the
# last thing the OOM killer may take (never -1000 = unkillable hang risk).
Nice=-5
OOMScoreAdjust=-300
StandardOutput=append:%h/quran-live-stream/logs/systemd_youtube.log
StandardError=append:%h/quran-live-stream/logs/systemd_youtube.log

[Install]
WantedBy=default.target