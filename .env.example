# مفاتيح البث - لا تشاركها
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
TIKTOK_RTMP_URL=rtmp://rtmp.tiktok.com/live
TIKTOK_STREAM_KEY=your_tiktok_key
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VIDEO_BITRATE=2500k
AUDIO_BITRATE=128k
FPS=30
PRESET=ultrafast

# --- Ultra-Low Resource Quran Mode (<=1GB RAM / 1 vCPU) ---
# Force it explicitly (auto-selected when RAM <= 1000MB):
# STREAM_PROFILE=micro        # 854x480 @10fps, ~800k, 1-thread x264, muted chrome
# Audio path (micro defaults to "file"; others default to "pulse"):
# AUDIO_MODE=file             # concat local mp3s, no PulseAudio in audio path
# AUDIO_MODE=pulse            # capture browser via PulseAudio sink (synced)
# Audio channels (micro defaults to 1 = dual-mono voice; others stereo):
# AUDIO_CHANNELS=1
# NOTE (file mode): display/audio sync assumes identical surah 1..114 file
# order on both sides; residual drift clears on daily restart. Run
# scripts/download_all_recitations.sh first for full-Quran coverage.

# --- First-run static primer (data saver) ---
# PRIME_STATIC=1 downloads fonts/audio/backgrounds once, then serves from
# disk. Dynamic data (clock/prayer/weather) always stays live and is never
# primed. Set PRIME_AUDIO=0 to skip the ~3.5GB recitation download.
# PRIME_STATIC=1
# PRIME_AUDIO=1

# --- Universal auto-tuning (any server, first boot) ---
# scripts/first_boot.sh measures the box (encode benchmark + egress probe) and
# writes runtime/host.env; hardware_profile picks nano/micro/eco/balanced
# automatically. Precedence: STREAM_PROFILE > benchmark > auto-detect.
# HOST_AUTO_PROFILE=0       # ignore benchmark result, use auto-detect
# HOST_BENCH_PROFILE=micro  # pin a profile manually (nano/micro/eco/balanced)
# EGRESS_GUARD=0            # disable uplink bitrate clamp
# BENCHMARK: scripts/benchmark_host.sh [--force] (freshness 7d)
# EGRESS:    scripts/probe_egress.sh [--force] (freshness 7d)
# PROVISION: scripts/tune_system.sh (swap/zram/sysctl, any distro, sudo)

# --- Encode-speed monitor + Telegram alerts ---
# Watches ffmpeg speed=; sustained < SPEED_MIN over SPEED_HITS checks (3-min
# cron) restarts the stream and alerts via Telegram (needs BOT_TOKEN+CHAT_ID;
# without them it only logs locally — nothing breaks).
# SPEED_MIN=0.8
# SPEED_HITS=3
# SPEED_MONITOR=0             # disable the monitor entirely

# --- CPU pinning (auto: encode=core0, browser=last core on 2+ CPUs) ---
# TASKSET_FFMPEG=0
# TASKSET_CHROME=1
# (empty value disables pinning)

# --- Hardware encode (auto-verified at preflight, 3s smoke test) ---
# NVENC is used automatically when the smoke test passes (same res/fps/rate).
# VAAPI/QSV need explicit opt-in (x11grab color chains vary per box):
# HW_ALLOW_EXPERIMENTAL=1

# --- Browser binary override (snap/playwright/manual paths, any arch) ---
# Empty = auto-detect (google-chrome, chromium-browser, chromium).
# CHROME_BIN=/snap/bin/chromium

# --- Lifecycle ---
# control.sh prepare  -> full download + benchmark + probe + preflight (no stream)
# control.sh preflight -> checks only; refuses to start on HARD FAIL
# Daily 03:30 maintenance re-tunes weekly (clean window) and restarts.
# No bulk downloads ever run while the encoder is active (by design).
# Live-only broadcast: no recording, no file loop, no local archive.

# --- TikTok standalone (file-based, no browser) ---
# TASKSET_TIKTOK=1
# FPS=15 / VIDEO_BITRATE_TT=2000k (defaults already lean)

# Optional: Quran Foundation Content API (kept server-side)
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_EN_TAFSIR_ID=169
QF_AR_TAFSIR_ID=
# Fallback only when the city-specific primary source is unavailable
PRAYER_METHOD=3
